<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MediaLog.ViewModels"
             xmlns:m="using:MediaLog.Models"
             xmlns:c="using:MediaLog.Controls"
             xmlns:views="using:MediaLog.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MediaLog.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.DataTemplates>
        <!-- Media type: colored icon + label (used by the type picker) -->
        <DataTemplate DataType="m:MediaTypeInfo">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:StrokeIcon Data="{Binding Icon}" Foreground="{Binding Brush}" Width="18" Height="18" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Phones: date / list move to a second row of the add bar (see code-behind), type shows icon only -->
        <Style Selector="views|MainView.compact StackPanel#Meta > Border.sep">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|MainView.compact TextBlock.compactType">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|MainView.compact TextBlock.typeLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto,Auto">
        <SplitView x:Name="Split"
                   IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                   DisplayMode="Inline"
                   OpenPaneLength="260"
                   CompactPaneLength="0"
                   PaneBackground="{DynamicResource PaneBackground}">

            <!-- ============ Navigation pane ============ -->
            <SplitView.Pane>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12" Spacing="2">
                        <TextBlock Text="MediaLog" FontSize="22" FontWeight="Bold" />
                        <TextBlock Classes="subtle" Text="Everything you've finished" FontSize="12" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="10">
                        <Button Classes="navAction" Command="{Binding RefreshAllInfoCommand}" HorizontalAlignment="Stretch"
                                ToolTip.Tip="Look up every entry online and fill in missing year, credits, covers…">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <c:StrokeIcon Data="{x:Static c:Icons.Refresh}" Width="18" Height="18" Foreground="{DynamicResource SubtleText}" />
                                <TextBlock Text="Refresh all info" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="navAction" Command="{Binding OpenTypeManagerCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <c:StrokeIcon Data="{x:Static c:Icons.Tag}" Width="18" Height="18" Foreground="{DynamicResource SubtleText}" />
                                <TextBlock Text="Media types" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding NewListName}" PlaceholderText="New list…">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddListCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding AddListCommand}" ToolTip.Tip="Create list" Padding="9">
                                <c:StrokeIcon Data="{x:Static c:Icons.Plus}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="Nav" Classes="nav"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             SelectionMode="AlwaysSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ListViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="{Binding Indent}">
                                    <!-- expand arrow ("All media" only) -->
                                    <Button Classes="chevron" Command="{Binding ToggleCommand}" IsVisible="{Binding IsMaster}"
                                            ToolTip.Tip="Show a list per type">
                                        <c:StrokeIcon Data="{Binding ChevronIcon}" Width="16" Height="16" />
                                    </Button>
                                    <!-- list icon; type lists use the type's color -->
                                    <c:StrokeIcon Grid.Column="1" Data="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0"
                                                  Foreground="{DynamicResource SubtleText}" IsVisible="{Binding !IsTypeList}" />
                                    <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Margin="0,0,9,0"
                                            Background="{Binding Type.Brush, FallbackValue={x:Null}}" IsVisible="{Binding IsTypeList}">
                                        <c:StrokeIcon Data="{Binding Type.Icon, FallbackValue={x:Null}}" Foreground="{Binding Type.OnBrush, FallbackValue={x:Null}}"
                                                      Width="13" Height="13" StrokeThickness="2.4" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding IsMaster, Converter={x:Static vm:Converters.BoolToSemiBold}}" />
                                    <Button Grid.Column="3" Classes="pin" Classes.pinned="{Binding IsPinned}"
                                            Command="{Binding ToggleCommand}" IsVisible="{Binding IsTypeList}"
                                            ToolTip.Tip="{Binding PinTip}">
                                        <c:StrokeIcon Data="{x:Static c:Icons.Pin}" Width="15" Height="15" />
                                    </Button>
                                    <Border Grid.Column="4" Background="{DynamicResource CardBorder}" CornerRadius="10" Padding="8,1" MinWidth="26"
                                            VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Count}" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </SplitView.Pane>

            <!-- ============ Content ============ -->
            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,4">
                    <Button x:Name="PaneToggle" Classes="icon" Command="{Binding TogglePaneCommand}" Margin="0,0,6,0" IsVisible="False">
                        <c:StrokeIcon Data="{x:Static c:Icons.Menu}" Width="22" Height="22" />
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Classes="title" Text="{Binding SelectedNav.Name, FallbackValue=''}"
                                 IsVisible="{Binding IsRenamableSelected}" ToolTip.Tip="Click to rename" />
                        <TextBlock Text="{Binding SelectedNav.Name, FallbackValue=''}" FontSize="24" FontWeight="SemiBold" Margin="5,2"
                                   IsVisible="{Binding !IsRenamableSelected}" />
                        <TextBlock Classes="subtle" Margin="5,0" Text="{Binding CountText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="editToggle" Classes.active="{Binding IsEditMode}" Command="{Binding ToggleEditModeCommand}"
                            IsVisible="{Binding !IsConfirmingDelete}" ToolTip.Tip="Show edit / delete buttons on entries">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:StrokeIcon Data="{Binding EditModeIcon}" Width="15" Height="15" />
                            <TextBlock Text="{Binding EditModeText}" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Border Classes="segmented" IsVisible="{Binding !IsConfirmingDelete}">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="seg" Classes.active="{Binding IsCardsMode}" Command="{Binding SetViewModeCommand}"
                                    CommandParameter="Cards" ToolTip.Tip="Cards">
                                <c:StrokeIcon Data="{x:Static c:Icons.ViewCards}" />
                            </Button>
                            <Button Classes="seg" Classes.active="{Binding IsTilesMode}" Command="{Binding SetViewModeCommand}"
                                    CommandParameter="Tiles" ToolTip.Tip="Tiles">
                                <c:StrokeIcon Data="{x:Static c:Icons.ViewTiles}" />
                            </Button>
                            <Button Classes="seg" Classes.active="{Binding IsCompactMode}" Command="{Binding SetViewModeCommand}"
                                    CommandParameter="Compact" ToolTip.Tip="Compact">
                                <c:StrokeIcon Data="{x:Static c:Icons.ViewCompact}" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding CanDeleteSelected}">
                        <Button Classes="icon danger" Command="{Binding RequestDeleteListCommand}" ToolTip.Tip="Delete list"
                                IsVisible="{Binding !IsConfirmingDelete}">
                            <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConfirmingDelete}">
                            <TextBlock Text="Delete list and its entries?" VerticalAlignment="Center" Classes="subtle" />
                            <Button Content="Delete" Command="{Binding ConfirmDeleteListCommand}" Background="#E53935" Foreground="White" />
                            <Button Content="Cancel" Command="{Binding CancelDeleteListCommand}" />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <!-- Per-type, color coded counters (click to filter) -->
                        <ItemsControl ItemsSource="{Binding Stats}" Margin="20,8,8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:BalancedWrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TypeStatViewModel">
                                    <Button Classes="chip" Command="{Binding ToggleCommand}" ToolTip.Tip="Filter by type">
                                        <Border Classes="chip" Background="{Binding Type.SoftBrush}"
                                                BorderBrush="{Binding BorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.Brush}" Width="16" Height="16" />
                                                <TextBlock Text="{Binding Type.Label}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Count}" FontWeight="Bold" VerticalAlignment="Center"
                                                           Foreground="{Binding Type.Brush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add entry bar: type · title · date · (list) · + -->
                        <Border Classes="composer" Margin="16,6,16,14">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <ComboBox Classes="typePicker" ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}"
                                              Background="{Binding NewType.Brush}" ToolTip.Tip="Type">
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate DataType="m:MediaTypeInfo">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:StrokeIcon Data="{Binding Icon}" Foreground="{Binding OnBrush}" Width="18" Height="18" StrokeThickness="2.2" />
                                                    <TextBlock Classes="typeLabel" Text="{Binding Label}" Foreground="{Binding OnBrush}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>

                                    <TextBox Grid.Column="1" Classes="bare" Text="{Binding NewName}"
                                             PlaceholderText="What did you finish?" VerticalAlignment="Center">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding AddEntryCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding NewSuggestions.DismissCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>

                                    <Border x:Name="MetaWide" Grid.Column="2">
                                        <StackPanel x:Name="Meta" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Classes="sep" IsVisible="{Binding IsNewGame}" />
                                            <AutoCompleteBox Classes="bare platform" Text="{Binding NewPlatform}" ItemsSource="{Binding PlatformNames}"
                                                             FilterMode="Contains" MinimumPrefixLength="1" PlaceholderText="Console" Width="140"
                                                             IsVisible="{Binding IsNewGame}"
                                                             ToolTip.Tip="Console. Type a new one to add it" />
                                            <Border Classes="sep" />
                                            <CalendarDatePicker Classes="bare" SelectedDate="{Binding NewDate}" Width="132"
                                                                SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy"
                                                                ToolTip.Tip="Date completed" />
                                            <Border Classes="sep" IsVisible="{Binding NeedsTargetList}" />
                                            <ComboBox Classes="bare" ItemsSource="{Binding UserLists}" SelectedItem="{Binding TargetList}"
                                                      IsVisible="{Binding NeedsTargetList}" PlaceholderText="List"
                                                      ToolTip.Tip="Add to list" MinWidth="96" />
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="3" Classes="cover" Command="{Binding OpenNewCoverCommand}"
                                            ToolTip.Tip="Choose a cover image">
                                        <Panel>
                                            <c:StrokeIcon Data="{x:Static c:Icons.Image}" Width="20" Height="20"
                                                          IsVisible="{Binding NewCover.Image, Converter={x:Static ObjectConverters.IsNull}}" />
                                            <Border CornerRadius="6" ClipToBounds="True" Width="30" Height="44"
                                                    IsVisible="{Binding NewCover.Image, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Image Source="{Binding NewCover.Image}" Stretch="UniformToFill" />
                                            </Border>
                                        </Panel>
                                    </Button>
                                    <Button Grid.Column="4" Classes="add" Command="{Binding AddEntryCommand}" ToolTip.Tip="Add (Enter)">
                                        <c:StrokeIcon Data="{x:Static c:Icons.Plus}" Foreground="White" Width="26" Height="26" StrokeThickness="2.6" />
                                    </Button>
                                </Grid>
                                <Border x:Name="MetaCompact" Margin="8,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Details of the picked match, saved with the entry -->
                        <Border Classes="detailsChip" Margin="28,-6,16,10" HorizontalAlignment="Left" IsVisible="{Binding HasNewDetails}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:StrokeIcon Data="{x:Static c:Icons.Check}" Width="14" Height="14" Foreground="#00C853" StrokeThickness="2.6" />
                                <TextBlock Text="{Binding NewDetailsText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Classes="icon" Padding="3" Command="{Binding ClearNewDetailsCommand}" ToolTip.Tip="Don't save these details">
                                    <c:StrokeIcon Data="{x:Static c:Icons.Close}" Width="12" Height="12" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Online matches for the title being typed -->
                        <views:TitleSuggestionsView DataContext="{Binding NewSuggestions}" Margin="16,-6,16,12" />

                        <!-- Search -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,0,16,8">
                            <TextBox Text="{Binding SearchText}" PlaceholderText="Search…">
                                <TextBox.InnerLeftContent>
                                    <c:StrokeIcon Data="{x:Static c:Icons.Search}" Width="16" Height="16" Margin="10,0,0,0"
                                                  Foreground="{DynamicResource SubtleText}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <Button Grid.Column="1" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                                    IsVisible="{Binding IsFiltered}" />
                        </Grid>

                        <!-- Entries: cards view -->
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="16,0,16,16" IsVisible="{Binding IsCardsMode}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EntryViewModel">
                                    <Border Classes="card entry" Margin="0,0,0,6" ClipToBounds="True">
                                        <Grid ColumnDefinitions="4,Auto,Auto,*,Auto">
                                            <!-- color stripe -->
                                            <Border Background="{Binding Type.Brush}" />
                                            <!-- thumbnail: shaped like the cover (uncropped), like tiles; placeholder only without one -->
                                            <!-- fixed-width slot so titles line up whatever the cover's shape -->
                                            <Panel Grid.Column="1" Width="72" Margin="6,8" VerticalAlignment="Center">
                                            <Border Width="{Binding ThumbWidth}" Height="46" CornerRadius="5"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding CoverBackground}" ClipToBounds="True">
                                                <Panel>
                                                    <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="18" Height="18"
                                                                  StrokeThickness="2.2" IsVisible="{Binding !HasImage}" />
                                                    <Image Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding HasImage}" />
                                                </Panel>
                                            </Border>
                                            </Panel>
                                            <!-- type-colored divider between thumbnail and title -->
                                            <Border Grid.Column="2" Width="2" Margin="0,0,12,0" Background="{Binding Type.Brush}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1" Margin="0,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                                <WrapPanel ItemSpacing="6" IsVisible="{Binding HasDetailsOrPlatform}">
                                                    <TextBlock Text="{Binding Details}" FontSize="12" IsVisible="{Binding HasDetails}" TextWrapping="Wrap"
                                                               VerticalAlignment="Center" />
                                                    <Border Classes="platformBadge" Background="{Binding Platform.Brush, FallbackValue={x:Null}}" IsVisible="{Binding HasPlatform}">
                                                        <TextBlock Text="{Binding Platform.Short, FallbackValue=''}" Foreground="{Binding Platform.OnBrush, FallbackValue={x:Null}}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding CreditsLine}" Classes="subtle" FontSize="12" IsVisible="{Binding HasCredits}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <WrapPanel ItemSpacing="6">
                                                    <TextBlock Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Classes="subtle" Text="·" FontSize="12" />
                                                    <TextBlock Classes="subtle" Text="{Binding DateText}" FontSize="12" />
                                                    <TextBlock Classes="subtle" Text="·" FontSize="12" IsVisible="{Binding ShowList}" />
                                                    <TextBlock Classes="subtle" Text="{Binding List.Name}" FontSize="12" IsVisible="{Binding ShowList}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,8,0" IsVisible="{Binding ShowActions}">
                                                <Button Classes="icon" Command="{Binding EditCommand}" ToolTip.Tip="Edit entry">
                                                    <c:StrokeIcon Data="{x:Static c:Icons.Pencil}" />
                                                </Button>
                                                <Button Classes="icon danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Remove entry">
                                                    <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Entries: tiles view (all tiles the same size; details are in the card) -->
                        <ItemsControl x:Name="TilesView" ItemsSource="{Binding Entries}" Margin="12,0,12,16" IsVisible="{Binding IsTilesMode}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding TileColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EntryViewModel">
                                    <Border Classes="card entry" Margin="4" ClipToBounds="True">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <!-- cover box: same shape for every tile; the cover is fitted inside, uncropped -->
                                            <c:AspectBox Ratio="1.3">
                                                <Border Background="{Binding TileCoverBackground}" ClipToBounds="True">
                                                    <Panel>
                                                        <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}"
                                                                      Width="44" Height="44" StrokeThickness="1.8" IsVisible="{Binding !HasImage}" />
                                                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="6" IsVisible="{Binding HasImage}" />
                                                        <!-- console badge -->
                                                        <Border Classes="platformBadge large" Background="{Binding Platform.Brush, FallbackValue={x:Null}}" IsVisible="{Binding HasPlatform}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                            <TextBlock Text="{Binding Platform.Short, FallbackValue=''}" Foreground="{Binding Platform.OnBrush, FallbackValue={x:Null}}" />
                                                        </Border>
                                                        <!-- type badge over the cover image -->
                                                        <Border Width="26" Height="26" CornerRadius="13" Margin="8" Background="{Binding Type.Brush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding HasImage}"
                                                                BorderBrush="#CCFFFFFF" BorderThickness="1.5">
                                                            <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="14" Height="14" StrokeThickness="2.4" />
                                                        </Border>
                                                    </Panel>
                                                </Border>
                                            </c:AspectBox>
                                            <Border Classes="tileActions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                    IsVisible="{Binding ShowActions}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Classes="icon tileButton" Command="{Binding EditCommand}" ToolTip.Tip="Edit entry / choose image">
                                                        <c:StrokeIcon Data="{x:Static c:Icons.Pencil}" Foreground="White" Width="15" Height="15" />
                                                    </Button>
                                                    <Button Classes="icon tileButton" Command="{Binding DeleteCommand}" ToolTip.Tip="Remove entry">
                                                        <c:StrokeIcon Data="{x:Static c:Icons.Trash}" Foreground="White" Width="15" Height="15" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <!-- type-colored line between cover and info -->
                                            <Border Grid.Row="1" Height="3" Background="{Binding Type.Brush}" />
                                            <!-- fixed-height info: longer text ends in "…" (everything is in the card) -->
                                            <Grid Grid.Row="2" Height="82" Margin="10,7,10,8" RowDefinitions="*,Auto">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Classes="subtle" IsVisible="{Binding HasDetails}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBlock Classes="subtle" FontSize="11" Text="·" />
                                                    <TextBlock Classes="subtle" FontSize="11" Text="{Binding DateText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Entries: compact view -->
                        <Border Classes="card" Margin="16,0,16,16" Padding="0,4">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsCompactMode" />
                                    <Binding Path="!IsEmpty" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:EntryViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Classes="compactRow entry" Height="34">
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="12,0,10,0" Background="{Binding Type.Brush}">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="12" Height="12" StrokeThickness="2.4" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                                <TextBlock Text="{Binding Details}" Classes="subtle compactType" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <Border Classes="platformBadge" Background="{Binding Platform.Brush, FallbackValue={x:Null}}" IsVisible="{Binding HasPlatform}">
                                                    <TextBlock Text="{Binding Platform.Short, FallbackValue=''}" Foreground="{Binding Platform.OnBrush, FallbackValue={x:Null}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0" Classes="compactType" />
                                            <TextBlock Grid.Column="3" Classes="subtle" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center"
                                                       MinWidth="78" TextAlignment="Right" Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,6,0" IsVisible="{Binding ShowActions}">
                                                <Button Classes="icon" Padding="6" Command="{Binding EditCommand}" ToolTip.Tip="Edit entry">
                                                    <c:StrokeIcon Data="{x:Static c:Icons.Pencil}" Width="15" Height="15" />
                                                </Button>
                                                <Button Classes="icon danger" Padding="6" Command="{Binding DeleteCommand}" ToolTip.Tip="Remove entry">
                                                    <c:StrokeIcon Data="{x:Static c:Icons.Trash}" Width="15" Height="15" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Classes="subtle" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                                   HorizontalAlignment="Center" Margin="24,16" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView>

        <!-- Refresh-all progress -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="16,8"
                IsVisible="{Binding RefreshStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <c:StrokeIcon Data="{x:Static c:Icons.Refresh}" Width="18" Height="18" Foreground="{DynamicResource SubtleText}" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RefreshStatus}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding RefreshProgress}" Maximum="1" IsVisible="{Binding IsRefreshing}" />
                </StackPanel>
                <Panel Grid.Column="2">
                    <Button Content="Stop" Command="{Binding CancelRefreshCommand}" IsVisible="{Binding IsRefreshing}" />
                    <Button Classes="icon" Command="{Binding DismissRefreshCommand}" IsVisible="{Binding !IsRefreshing}">
                        <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                    </Button>
                </Panel>
            </Grid>
        </Border>

        <!-- Undo bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="16,8"
                IsVisible="{Binding UndoText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding DismissUndoCommand}">
                    <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                </Button>
            </Grid>
        </Border>
        <!-- ============ Entry details (press and hold an entry) ============ -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsDetailsOpen}">
            <!-- clicking / tapping outside the card closes it -->
            <Border x:Name="DetailsBackdrop" Background="#99000000" />
            <Border Classes="card" MaxWidth="560" MaxHeight="860" Margin="12,24" Padding="0" VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #40000000" ClipToBounds="True"
                    DataContext="{Binding DetailEntry}" x:DataType="vm:EntryViewModel">
                <Grid>
                    <ScrollViewer>
                        <StackPanel Margin="0,0,0,8">
                            <!-- cover, whole -->
                            <Border Background="{DynamicResource AppBackground}" Padding="16">
                                <Panel>
                                    <Border Width="140" Height="140" CornerRadius="12" Background="{Binding Type.Brush}"
                                            IsVisible="{Binding !HasImage}" HorizontalAlignment="Center">
                                        <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="56" Height="56" StrokeThickness="1.6" />
                                    </Border>
                                    <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="320" IsVisible="{Binding HasImage}" />
                                </Panel>
                            </Border>
                            <Border Height="3" Background="{Binding Type.Brush}" />
                            <StackPanel Margin="20,14,20,8" Spacing="10">
                                <!-- title, with the completion date featured on the right -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DateText}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{Binding Type.Brush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="completed" Classes="subtle" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <Border Background="{Binding Type.SoftBrush}" CornerRadius="12" Padding="10,3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.Brush}" Width="14" Height="14" />
                                            <TextBlock Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="platformBadge large" Background="{Binding Platform.Brush, FallbackValue={x:Null}}" IsVisible="{Binding HasPlatform}">
                                        <TextBlock Text="{Binding Platform.Name, FallbackValue=''}" Foreground="{Binding Platform.OnBrush, FallbackValue={x:Null}}" />
                                    </Border>
                                </WrapPanel>
                                <!-- every detail as label / value rows -->
                                <ItemsControl ItemsSource="{Binding DetailRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="m:Credit">
                                            <Grid ColumnDefinitions="120,*" Margin="0,3">
                                                <TextBlock Text="{Binding Role}" Classes="subtle" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Cover for a new entry (overlay) ============ -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsNewCoverOpen}">
            <Border Background="#99000000" />
            <Border Classes="card" MaxWidth="640" MaxHeight="820" Margin="12,24" Padding="0"
                    VerticalAlignment="Center" BoxShadow="0 12 40 0 #40000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,14,10,6">
                        <Border Width="40" Height="60" CornerRadius="6" ClipToBounds="True" Background="{Binding NewType.Brush}">
                            <Panel>
                                <c:StrokeIcon Data="{Binding NewType.Icon}" Foreground="{Binding NewType.OnBrush}" Width="20" Height="20" />
                                <Image Source="{Binding NewCover.Image}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Cover image" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Classes="subtle" FontSize="12" Text="Used for the entry you're adding" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon" Command="{Binding CloseNewCoverCommand}" ToolTip.Tip="Close">
                            <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <views:CoverPickerView DataContext="{Binding NewCover}" Margin="20,4,20,16" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="20,10,20,16">
                        <Button Content="No image" Command="{Binding NewCover.RemoveCommand}" IsVisible="{Binding NewCover.HasImage}" />
                        <Button Grid.Column="2" Classes="accent" Content="Done" Command="{Binding CloseNewCoverCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Edit entry (overlay) ============ -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsEditorOpen}">
            <Border Background="#99000000" />
            <Border Classes="card" MaxWidth="640" MaxHeight="860" Margin="12,24" Padding="0"
                    VerticalAlignment="Center" BoxShadow="0 12 40 0 #40000000"
                    DataContext="{Binding Editor}" x:DataType="vm:EntryEditorViewModel">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,14,10,6">
                        <TextBlock Text="Edit entry" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" ToolTip.Tip="Close">
                            <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,4,20,16" Spacing="14">
                            <!-- Details -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <!-- current image / placeholder -->
                                <Border Width="96" Height="136" CornerRadius="10" ClipToBounds="True" Background="{Binding Type.Brush}"
                                        VerticalAlignment="Top">
                                    <Panel>
                                        <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="36" Height="36" StrokeThickness="1.8" />
                                        <Image Source="{Binding Cover.Image}" Stretch="UniformToFill"
                                               IsVisible="{Binding Cover.Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding Name}" PlaceholderText="Title" FontSize="15" />
                                        <Button Grid.Column="1" Content="Look up" Command="{Binding LookUpCommand}"
                                                ToolTip.Tip="Find this title online and fill in its details" />
                                    </Grid>
                                    <views:TitleSuggestionsView DataContext="{Binding Suggestions}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" MinWidth="170" ToolTip.Tip="Type" />
                                        <CalendarDatePicker SelectedDate="{Binding Date}" Width="150"
                                                            SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy" ToolTip.Tip="Date completed" />
                                        <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding List}" MinWidth="130" ToolTip.Tip="List" />
                                        <AutoCompleteBox Text="{Binding PlatformText}" ItemsSource="{Binding PlatformNames}" FilterMode="Contains"
                                                         MinimumPrefixLength="1" PlaceholderText="Console" Width="170" IsVisible="{Binding IsGame}"
                                                         ToolTip.Tip="Console. Type a new one to add it" />
                                    </WrapPanel>
                                    <Grid ColumnDefinitions="80,*,*" ColumnSpacing="8">
                                        <TextBox Text="{Binding YearText}" PlaceholderText="Year" ToolTip.Tip="Year" />
                                        <TextBox Grid.Column="1" Text="{Binding Creator}" PlaceholderText="Director / author / creator"
                                                 ToolTip.Tip="Director, author, developer, artist, studio…" />
                                        <TextBox Grid.Column="2" Text="{Binding Length}" PlaceholderText="Length / episodes"
                                                 ToolTip.Tip="Running time, pages, episodes…" />
                                    </Grid>
                                    <TextBox Text="{Binding CreditsText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                                             PlaceholderText="Credits, one per line (e.g. Composer: Koji Kondo)" FontSize="13" />
                                    <Button Content="Remove image" Command="{Binding Cover.RemoveCommand}" IsVisible="{Binding Cover.HasImage}" />
                                </StackPanel>
                            </Grid>

                            <!-- Image search -->
                            <Border Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Cover image" FontWeight="SemiBold" Classes="subtle" />
                                    <views:CoverPickerView DataContext="{Binding Cover}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="20,10,20,16">
                        <Button Classes="icon danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete entry">
                            <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                        </Button>
                        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
                        <Button Grid.Column="3" Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Media types manager (overlay) ============ -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsTypeManagerOpen}">
            <Border Background="#99000000" />
            <Border Classes="card" MaxWidth="600" MaxHeight="820" Margin="12,24" Padding="0"
                    VerticalAlignment="Center" BoxShadow="0 12 40 0 #40000000">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,14,10,6">
                        <TextBlock Text="Media types" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseTypeManagerCommand}" ToolTip.Tip="Close">
                            <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,4,20,20" Spacing="12">
                            <!-- Editor -->
                            <Border Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding TypeEditorTitle}" FontWeight="SemiBold" Classes="subtle" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="44" Height="44" CornerRadius="22" Background="{Binding EditPreview.Brush}">
                                            <c:StrokeIcon Data="{Binding EditPreview.Icon}" Foreground="{Binding EditPreview.OnBrush}" Width="22" Height="22" StrokeThickness="2.2" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditTypeName}" PlaceholderText="Type name (e.g. Manga, Board game)"
                                                 VerticalAlignment="Center">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding SaveTypeCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </Grid>

                                    <TextBlock Text="Color" Classes="subtle" FontSize="12" />
                                    <ListBox Classes="swatches" ItemsSource="{x:Static vm:MainViewModel.Palette}" SelectedItem="{Binding EditPaletteColor}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:PaletteColor">
                                                <Ellipse Width="28" Height="28" Fill="{Binding Brush}" ToolTip.Tip="{Binding Hex}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBox Text="{Binding EditTypeColor}" PlaceholderText="#RRGGBB" Width="130" HorizontalAlignment="Left"
                                             ToolTip.Tip="Any color as hex" />

                                    <TextBlock Text="Icon" Classes="subtle" FontSize="12" />
                                    <ListBox Classes="swatches" ItemsSource="{x:Static vm:MainViewModel.IconOptions}" SelectedItem="{Binding EditTypeIcon}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="m:TypeIcon">
                                                <c:StrokeIcon Data="{Binding Geometry}" Width="22" Height="22" Margin="3"
                                                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="accent" Content="{Binding SaveTypeText}" Command="{Binding SaveTypeCommand}" />
                                        <Button Content="Cancel" Command="{Binding StartNewTypeCommand}" IsVisible="{Binding IsEditingType}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Existing types -->
                            <ItemsControl ItemsSource="{Binding TypeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TypeRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Type.Brush}">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="17" Height="17" StrokeThickness="2.2" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type.Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UsageText}" Classes="subtle" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="icon" Command="{Binding EditCommand}" ToolTip.Tip="Edit type">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Pencil}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="icon danger" Command="{Binding DeleteCommand}" ToolTip.Tip="{Binding DeleteTip}">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
