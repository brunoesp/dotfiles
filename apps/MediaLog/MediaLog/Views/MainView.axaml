<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MediaLog.ViewModels"
             xmlns:m="using:MediaLog.Models"
             xmlns:c="using:MediaLog.Controls"
             xmlns:views="using:MediaLog.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MediaLog.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.DataTemplates>
        <!-- Media type: colored icon + label (used by the type picker) -->
        <DataTemplate DataType="m:MediaTypeInfo">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:StrokeIcon Data="{Binding Icon}" Foreground="{Binding Brush}" Width="18" Height="18" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Phones: date / list move to a second row of the add bar (see code-behind), type shows icon only -->
        <Style Selector="views|MainView.compact StackPanel#Meta > Border.sep">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|MainView.compact TextBlock.compactType">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|MainView.compact TextBlock.typeLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <SplitView x:Name="Split"
                   IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                   DisplayMode="Inline"
                   OpenPaneLength="260"
                   CompactPaneLength="0"
                   PaneBackground="{DynamicResource PaneBackground}">

            <!-- ============ Navigation pane ============ -->
            <SplitView.Pane>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12" Spacing="2">
                        <TextBlock Text="MediaLog" FontSize="22" FontWeight="Bold" />
                        <TextBlock Classes="subtle" Text="Everything you've finished" FontSize="12" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="10">
                        <Button Classes="navAction" Command="{Binding OpenTypeManagerCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <c:StrokeIcon Data="{x:Static c:Icons.Tag}" Width="18" Height="18" Foreground="{DynamicResource SubtleText}" />
                                <TextBlock Text="Media types" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding NewListName}" PlaceholderText="New list…">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddListCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding AddListCommand}" ToolTip.Tip="Create list" Padding="9">
                                <c:StrokeIcon Data="{x:Static c:Icons.Plus}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="Nav" Classes="nav"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             SelectionMode="AlwaysSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ListViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="{Binding Indent}">
                                    <!-- expand arrow ("All media" only) -->
                                    <Button Classes="chevron" Command="{Binding ToggleCommand}" IsVisible="{Binding IsMaster}"
                                            ToolTip.Tip="Show a list per type">
                                        <c:StrokeIcon Data="{Binding ChevronIcon}" Width="16" Height="16" />
                                    </Button>
                                    <!-- list icon; type lists use the type's color -->
                                    <c:StrokeIcon Grid.Column="1" Data="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0"
                                                  Foreground="{DynamicResource SubtleText}" IsVisible="{Binding !IsTypeList}" />
                                    <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Margin="0,0,9,0"
                                            Background="{Binding Type.Brush, FallbackValue={x:Null}}" IsVisible="{Binding IsTypeList}">
                                        <c:StrokeIcon Data="{Binding Type.Icon, FallbackValue={x:Null}}" Foreground="{Binding Type.OnBrush, FallbackValue={x:Null}}"
                                                      Width="13" Height="13" StrokeThickness="2.4" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding IsMaster, Converter={x:Static vm:Converters.BoolToSemiBold}}" />
                                    <Button Grid.Column="3" Classes="pin" Classes.pinned="{Binding IsPinned}"
                                            Command="{Binding ToggleCommand}" IsVisible="{Binding IsTypeList}"
                                            ToolTip.Tip="{Binding PinTip}">
                                        <c:StrokeIcon Data="{x:Static c:Icons.Pin}" Width="15" Height="15" />
                                    </Button>
                                    <Border Grid.Column="4" Background="{DynamicResource CardBorder}" CornerRadius="10" Padding="8,1" MinWidth="26"
                                            VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Count}" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </SplitView.Pane>

            <!-- ============ Content ============ -->
            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,4">
                    <Button x:Name="PaneToggle" Classes="icon" Command="{Binding TogglePaneCommand}" Margin="0,0,6,0" IsVisible="False">
                        <c:StrokeIcon Data="{x:Static c:Icons.Menu}" Width="22" Height="22" />
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Classes="title" Text="{Binding SelectedNav.Name, FallbackValue=''}"
                                 IsVisible="{Binding IsRenamableSelected}" ToolTip.Tip="Click to rename" />
                        <TextBlock Text="{Binding SelectedNav.Name, FallbackValue=''}" FontSize="24" FontWeight="SemiBold" Margin="5,2"
                                   IsVisible="{Binding !IsRenamableSelected}" />
                        <TextBlock Classes="subtle" Margin="5,0" Text="{Binding CountText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="segmented" IsVisible="{Binding !IsConfirmingDelete}">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="seg" Classes.active="{Binding IsCardsMode}" Command="{Binding SetViewModeCommand}"
                                    CommandParameter="Cards" ToolTip.Tip="Cards">
                                <c:StrokeIcon Data="{x:Static c:Icons.ViewCards}" />
                            </Button>
                            <Button Classes="seg" Classes.active="{Binding IsTilesMode}" Command="{Binding SetViewModeCommand}"
                                    CommandParameter="Tiles" ToolTip.Tip="Tiles">
                                <c:StrokeIcon Data="{x:Static c:Icons.ViewTiles}" />
                            </Button>
                            <Button Classes="seg" Classes.active="{Binding IsCompactMode}" Command="{Binding SetViewModeCommand}"
                                    CommandParameter="Compact" ToolTip.Tip="Compact">
                                <c:StrokeIcon Data="{x:Static c:Icons.ViewCompact}" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding CanDeleteSelected}">
                        <Button Classes="icon danger" Command="{Binding RequestDeleteListCommand}" ToolTip.Tip="Delete list"
                                IsVisible="{Binding !IsConfirmingDelete}">
                            <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConfirmingDelete}">
                            <TextBlock Text="Delete list and its entries?" VerticalAlignment="Center" Classes="subtle" />
                            <Button Content="Delete" Command="{Binding ConfirmDeleteListCommand}" Background="#E53935" Foreground="White" />
                            <Button Content="Cancel" Command="{Binding CancelDeleteListCommand}" />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <!-- Per-type, color coded counters (click to filter) -->
                        <ItemsControl ItemsSource="{Binding Stats}" Margin="20,8,16,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TypeStatViewModel">
                                    <Button Classes="chip" Command="{Binding ToggleCommand}" ToolTip.Tip="Filter by type">
                                        <Border Classes="chip" Background="{Binding Type.SoftBrush}"
                                                BorderBrush="{Binding BorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.Brush}" Width="16" Height="16" />
                                                <TextBlock Text="{Binding Type.Label}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Count}" FontWeight="Bold" VerticalAlignment="Center"
                                                           Foreground="{Binding Type.Brush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add entry bar: type · title · date · (list) · + -->
                        <Border Classes="composer" Margin="16,6,16,14">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <ComboBox Classes="typePicker" ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}"
                                              Background="{Binding NewType.Brush}" ToolTip.Tip="Type">
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate DataType="m:MediaTypeInfo">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:StrokeIcon Data="{Binding Icon}" Foreground="{Binding OnBrush}" Width="18" Height="18" StrokeThickness="2.2" />
                                                    <TextBlock Classes="typeLabel" Text="{Binding Label}" Foreground="{Binding OnBrush}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>

                                    <TextBox Grid.Column="1" Classes="bare" Text="{Binding NewName}"
                                             PlaceholderText="What did you finish?" VerticalAlignment="Center">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding AddEntryCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>

                                    <Border x:Name="MetaWide" Grid.Column="2">
                                        <StackPanel x:Name="Meta" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Classes="sep" />
                                            <CalendarDatePicker Classes="bare" SelectedDate="{Binding NewDate}" Width="132"
                                                                SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy"
                                                                ToolTip.Tip="Date completed" />
                                            <Border Classes="sep" IsVisible="{Binding NeedsTargetList}" />
                                            <ComboBox Classes="bare" ItemsSource="{Binding UserLists}" SelectedItem="{Binding TargetList}"
                                                      IsVisible="{Binding NeedsTargetList}" PlaceholderText="List"
                                                      ToolTip.Tip="Add to list" MinWidth="96" />
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="3" Classes="add" Command="{Binding AddEntryCommand}" ToolTip.Tip="Add (Enter)">
                                        <c:StrokeIcon Data="{x:Static c:Icons.Plus}" Foreground="White" Width="26" Height="26" StrokeThickness="2.6" />
                                    </Button>
                                </Grid>
                                <Border x:Name="MetaCompact" Margin="8,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Search -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,0,16,8">
                            <TextBox Text="{Binding SearchText}" PlaceholderText="Search…">
                                <TextBox.InnerLeftContent>
                                    <c:StrokeIcon Data="{x:Static c:Icons.Search}" Width="16" Height="16" Margin="10,0,0,0"
                                                  Foreground="{DynamicResource SubtleText}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <Button Grid.Column="1" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                                    IsVisible="{Binding IsFiltered}" />
                        </Grid>

                        <!-- Entries: cards view -->
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="16,0,16,16" IsVisible="{Binding IsCardsMode}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EntryViewModel">
                                    <Border Classes="card" Margin="0,0,0,6" ClipToBounds="True">
                                        <Grid ColumnDefinitions="4,Auto,*,Auto">
                                            <!-- color stripe -->
                                            <Border Background="{Binding Type.Brush}" />
                                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Margin="10,7"
                                                    Background="{Binding Type.Brush}">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="18" Height="18" StrokeThickness="2.2" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                                <WrapPanel ItemSpacing="6">
                                                    <TextBlock Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Classes="subtle" Text="·" FontSize="12" />
                                                    <TextBlock Classes="subtle" Text="{Binding DateText}" FontSize="12" />
                                                    <TextBlock Classes="subtle" Text="·" FontSize="12" IsVisible="{Binding ShowList}" />
                                                    <TextBlock Classes="subtle" Text="{Binding List.Name}" FontSize="12" IsVisible="{Binding ShowList}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <Button Grid.Column="3" Classes="icon danger" Margin="4,0,8,0"
                                                    Command="{Binding DeleteCommand}" ToolTip.Tip="Remove entry">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Entries: tiles view -->
                        <ItemsControl x:Name="TilesView" ItemsSource="{Binding Entries}" Margin="12,0,12,16" IsVisible="{Binding IsTilesMode}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding TileColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EntryViewModel">
                                    <Border Classes="card" Margin="4" ClipToBounds="True">
                                        <Grid RowDefinitions="88,Auto">
                                            <Border Background="{Binding Type.Brush}">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}"
                                                              Width="40" Height="40" StrokeThickness="1.8" />
                                            </Border>
                                            <Button Classes="icon tileDelete" Command="{Binding DeleteCommand}" ToolTip.Tip="Remove entry"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Trash}" Foreground="{Binding Type.OnBrush}" Width="15" Height="15" />
                                            </Button>
                                            <StackPanel Grid.Row="1" Margin="10,8,10,10" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold" FontSize="11" />
                                                <TextBlock Classes="subtle" FontSize="11" Text="{Binding DateText}" />
                                                <TextBlock Classes="subtle" FontSize="11" Text="{Binding List.Name}" IsVisible="{Binding ShowList}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Entries: compact view -->
                        <Border Classes="card" Margin="16,0,16,16" Padding="0,4">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsCompactMode" />
                                    <Binding Path="!IsEmpty" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:EntryViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Classes="compactRow" Height="34">
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="12,0,10,0" Background="{Binding Type.Brush}">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="12" Height="12" StrokeThickness="2.4" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" />
                                            <TextBlock Grid.Column="2" Text="{Binding Type.Label}" Foreground="{Binding Type.Brush}" FontWeight="SemiBold"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0" Classes="compactType" />
                                            <TextBlock Grid.Column="3" Classes="subtle" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center"
                                                       MinWidth="78" TextAlignment="Right" />
                                            <Button Grid.Column="4" Classes="icon danger" Padding="6" Margin="4,0,6,0"
                                                    Command="{Binding DeleteCommand}" ToolTip.Tip="Remove entry">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Trash}" Width="15" Height="15" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Classes="subtle" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                                   HorizontalAlignment="Center" Margin="24,16" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView>

        <!-- Undo bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="16,8"
                IsVisible="{Binding UndoText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding DismissUndoCommand}">
                    <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                </Button>
            </Grid>
        </Border>
        <!-- ============ Media types manager (overlay) ============ -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsTypeManagerOpen}">
            <Border Background="#99000000" />
            <Border Classes="card" MaxWidth="600" MaxHeight="820" Margin="12,24" Padding="0"
                    VerticalAlignment="Center" BoxShadow="0 12 40 0 #40000000">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,14,10,6">
                        <TextBlock Text="Media types" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseTypeManagerCommand}" ToolTip.Tip="Close">
                            <c:StrokeIcon Data="{x:Static c:Icons.Close}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,4,20,20" Spacing="12">
                            <!-- Editor -->
                            <Border Background="{DynamicResource AppBackground}" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding TypeEditorTitle}" FontWeight="SemiBold" Classes="subtle" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="44" Height="44" CornerRadius="22" Background="{Binding EditPreview.Brush}">
                                            <c:StrokeIcon Data="{Binding EditPreview.Icon}" Foreground="{Binding EditPreview.OnBrush}" Width="22" Height="22" StrokeThickness="2.2" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditTypeName}" PlaceholderText="Type name (e.g. Manga, Board game)"
                                                 VerticalAlignment="Center">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding SaveTypeCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </Grid>

                                    <TextBlock Text="Color" Classes="subtle" FontSize="12" />
                                    <ListBox Classes="swatches" ItemsSource="{x:Static vm:MainViewModel.Palette}" SelectedItem="{Binding EditPaletteColor}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:PaletteColor">
                                                <Ellipse Width="28" Height="28" Fill="{Binding Brush}" ToolTip.Tip="{Binding Hex}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBox Text="{Binding EditTypeColor}" PlaceholderText="#RRGGBB" Width="130" HorizontalAlignment="Left"
                                             ToolTip.Tip="Any color as hex" />

                                    <TextBlock Text="Icon" Classes="subtle" FontSize="12" />
                                    <ListBox Classes="swatches" ItemsSource="{x:Static vm:MainViewModel.IconOptions}" SelectedItem="{Binding EditTypeIcon}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="m:TypeIcon">
                                                <c:StrokeIcon Data="{Binding Geometry}" Width="22" Height="22" Margin="3"
                                                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="accent" Content="{Binding SaveTypeText}" Command="{Binding SaveTypeCommand}" />
                                        <Button Content="Cancel" Command="{Binding StartNewTypeCommand}" IsVisible="{Binding IsEditingType}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Existing types -->
                            <ItemsControl ItemsSource="{Binding TypeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TypeRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Type.Brush}">
                                                <c:StrokeIcon Data="{Binding Type.Icon}" Foreground="{Binding Type.OnBrush}" Width="17" Height="17" StrokeThickness="2.2" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type.Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UsageText}" Classes="subtle" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="icon" Command="{Binding EditCommand}" ToolTip.Tip="Edit type">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Pencil}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="icon danger" Command="{Binding DeleteCommand}" ToolTip.Tip="{Binding DeleteTip}">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Trash}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
