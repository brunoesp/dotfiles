<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MediaLog.Controls"
             xmlns:m="using:MediaLog.Models"
             x:Class="MediaLog.App"
             Name="MediaLog"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F4F5F8" />
                    <SolidColorBrush x:Key="PaneBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorder" Color="#E2E4EA" />
                    <SolidColorBrush x:Key="SubtleText" Color="#6B7080" />
                    <SolidColorBrush x:Key="NavSelected" Color="#E8ECF8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#16171C" />
                    <SolidColorBrush x:Key="PaneBackground" Color="#1E2027" />
                    <SolidColorBrush x:Key="CardBackground" Color="#23252D" />
                    <SolidColorBrush x:Key="CardBorder" Color="#30333D" />
                    <SolidColorBrush x:Key="SubtleText" Color="#9A9FAE" />
                    <SolidColorBrush x:Key="NavSelected" Color="#2C3142" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TextBlock.subtle">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>

        <!-- Flat icon-only buttons -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon c|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="Button.icon:pointerover c|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Button.danger:pointerover c|StrokeIcon">
            <Setter Property="Foreground" Value="#E53935" />
        </Style>

        <!-- Add bar -->
        <Style Selector="Border.composer">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #1F000000" />
        </Style>
        <Style Selector="Border.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{DynamicResource CardBorder}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.typePicker">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ComboBox.typePicker /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{Binding $parent[ComboBox].((m:MediaTypeInfo)SelectedItem).OnBrush, FallbackValue=White}" />
        </Style>
        <Style Selector="ComboBox.typePicker:pointerover /template/ Border#Background, ComboBox.typePicker:pressed /template/ Border#Background, ComboBox.typePicker:focus-visible /template/ Border#Background">
            <Setter Property="Background" Value="{Binding $parent[ComboBox].Background}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <!-- Borderless inputs inside the add bar -->
        <Style Selector="TextBox.bare, CalendarDatePicker.bare, ComboBox.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="CalendarDatePicker.bare TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="CalendarDatePicker.bare /template/ Border#Background, CalendarDatePicker.bare:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.bare /template/ Border#Background, ComboBox.bare:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.cover">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cover c|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>

        <Style Selector="Button.add">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#3D5AFE" />
        </Style>
        <Style Selector="Button.add:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#536DFE" />
        </Style>
        <Style Selector="Button.add:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#304FFE" />
        </Style>
        <Style Selector="Button.add:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3D5AFE" />
        </Style>
        <Style Selector="Button.add:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Type manager swatches -->
        <Style Selector="ListBox.swatches">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="Button.navAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Sidebar: expand arrow and pin buttons -->
        <Style Selector="Button.chevron, Button.pin">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chevron">
            <Setter Property="Margin" Value="-6,0,6,0" />
        </Style>
        <Style Selector="Button.chevron c|StrokeIcon, Button.pin c|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.pin">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.pin:pointerover, Button.pin.pinned">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.pin.pinned c|StrokeIcon">
            <Setter Property="Fill" Value="{DynamicResource SubtleText}" />
        </Style>

        <!-- Edit mode toggle -->
        <Style Selector="Button.editToggle">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="Button.editToggle c|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.editToggle.active /template/ ContentPresenter#PART_ContentPresenter, Button.editToggle.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3D5AFE" />
            <Setter Property="BorderBrush" Value="#3D5AFE" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.editToggle.active c|StrokeIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- View mode switcher -->
        <Style Selector="Border.segmented">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.seg c|StrokeIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelected}" />
        </Style>
        <Style Selector="Button.seg.active c|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- Tiles: edit / delete buttons float over the cover -->
        <Style Selector="Border.tileActions">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.tileButton">
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Button.tileButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>

        <!-- Title suggestions -->
        <Style Selector="Border.suggestions">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #22000000" />
        </Style>
        <Style Selector="Button.suggestion">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.suggestion:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelected}" />
        </Style>
        <Style Selector="Border.detailsChip">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3,4,3" />
        </Style>

        <!-- Image suggestions -->
        <Style Selector="ListBox.imageResults">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.imageResults ListBoxItem">
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.imageResults ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.imageResults ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3D5AFE" />
        </Style>

        <!-- Compact rows: hairline separators -->
        <Style Selector="Grid.compactRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid.compactRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavSelected}" />
        </Style>

        <!-- Sidebar list -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelected}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelected}" />
        </Style>

        <!-- Name of a user list, editable in place -->
        <Style Selector="TextBox.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        </Style>
        <Style Selector="TextBox.title:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        </Style>

        <!-- Type count chips: the inner border carries the type color -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.chip Border.chip">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Application.Styles>
</Application>
